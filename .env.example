# RAG-NetTwin Environment Configuration
# Copy this file to .env and fill in your actual values

# =============================================================================
# LLM Provider Configuration
# =============================================================================
# Choose your LLM provider: 'groq', 'gemini', or 'llamacpp'
LLM_PROVIDER=groq

# -----------------------------------------------------------------------------
# Groq Configuration
# -----------------------------------------------------------------------------
# Groq API Key - Get yours at https://console.groq.com/
# To use a single API key:
GROQ_API_KEY=your_groq_api_key_here

# To enable automatic API key rotation on rate limits (429), specify multiple keys.
# You can set a comma-separated list of keys in GROQ_API_KEYS:
# GROQ_API_KEYS=gsk_key1,gsk_key2,gsk_key3
# Or specify them as a comma-separated list directly inside GROQ_API_KEY:
# GROQ_API_KEY=gsk_key1,gsk_key2,gsk_key3

# Groq Model - Default: llama-3.3-70b-versatile
GROQ_MODEL=llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Gemini Configuration
# -----------------------------------------------------------------------------
# Gemini API Key - Get yours at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
# Gemini Model - Default: gemini-1.5-flash (or use gemini-1.5-pro)
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# LlamaCpp Configuration (Local LLM)
# -----------------------------------------------------------------------------
# Path to your GGUF model file
LLAMA_CPP_MODEL_PATH=./models/llama-3-8b-instruct.Q4_K_M.gguf
# Context window size
LLAMA_CPP_N_CTX=4096
# Number of layers to offload to GPU (-1 for all, 0 for none)
LLAMA_CPP_N_GPU_LAYERS=-1

# Alternative: Local LLM via Ollama (if API limits reached)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1:70b

# =============================================================================
# Vector Database Configuration
# =============================================================================
# ChromaDB Settings
CHROMA_DB_PATH=./data/chroma_db
CHROMA_COLLECTION_NAME=network_docs
EMBEDDING_MODEL=ibm-granite/granite-embedding-311m-multilingual-r2
RERANKER_MODEL=Alibaba-NLP/gte-reranker-modernbert-base

# =============================================================================
# Data Paths
# =============================================================================
RAW_DOCS_PATH=./data/raw_docs
PROCESSED_CHUNKS_PATH=./data/processed_chunks
GENERATED_CONFIGS_PATH=./data/configs

# =============================================================================
# Validation Tools Configuration
# =============================================================================
# Batfish (Tier 1 Validation)
BATFISH_HOST=localhost
BATFISH_PORT=9996

# Containerlab (Tier 2 Validation)
CONTAINERLAB_ENABLED=true
CONTAINERLAB_TIMEOUT=30

# GNS3 (Tier 3 Validation)
GNS3_ENABLED=true
GNS3_HOST=localhost
GNS3_PORT=3080
GNS3_PROJECT_PATH=./gns3_projects

# =============================================================================
# Application Settings
# =============================================================================
# Flask/FastAPI Configuration
FLASK_ENV=development
FLASK_DEBUG=true
API_PORT=5000
API_HOST=127.0.0.1

# =============================================================================
# Network Device Defaults
# =============================================================================
DEFAULT_VENDOR=Cisco
DEFAULT_OS=IOS-XE
DEFAULT_OS_VERSION=17.6

# =============================================================================
# RAG Configuration
# =============================================================================
# Retrieval Settings
TOP_K_RETRIEVAL=5
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# OS Version Locking
ENABLE_VERSION_LOCK=true
STRICT_VERSION_MATCH=true

# Self-Correction refinement loop (Tier 1/2/3 closed loop)
ENABLE_SELF_CORRECTION=false

# =============================================================================
# Logging
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=./logs/ragnet.log
